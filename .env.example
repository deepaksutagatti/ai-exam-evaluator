# Copy this file to .env before starting the app locally.
# Keep this file safe to share; never commit the real .env file.

# Required by the API server and database package.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_examiner

# Clerk keys. Use the same development instance as the hosted app.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Required for AI evaluation requests.
GEMINI_API_KEY=replace_me

# Optional local overrides. These are already the defaults.
API_PORT=5000
FRONTEND_PORT=5173
LOCAL_DEV=true
BASE_PATH=/
LOCAL_STORAGE_DIR=./uploads