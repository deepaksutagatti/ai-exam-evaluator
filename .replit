modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-9b55b75c-fc79-49fb-bfbb-12b85ab8919f"

[userenv]

[userenv.shared]
SUPABASE_URL = "https://gclwburkfkbeqpgnoxfb.supabase.co"
SUPABASE_STORAGE_BUCKET = "exam-files"
