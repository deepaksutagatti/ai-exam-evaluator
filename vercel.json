{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/ai-examiner run build",
  "outputDirectory": "artifacts/ai-examiner/dist/public",
  "rewrites": [
    {
       "source": "/api/:path*",
      "destination": "https://ai-examiner-api-fzaz.onrender.com/api/:path*"
    }
  ]
}
